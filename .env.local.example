# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email notifications)
RESEND_API_KEY=re_your-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Meta Facebook Login. Add the callback and data-deletion URL in the Meta app settings.
# Callback: https://agency-review-portal.vercel.app/api/auth/meta/callback
# Privacy: https://agency-review-portal.vercel.app/privacy#social-data-deletion
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://agency-review-portal.vercel.app/api/auth/meta/callback
META_GRAPH_API_VERSION=
META_LOGIN_CONFIG_ID=
# Configure Meta Login for Business to issue a user access token, not a system user token.

# Shared publishing worker (server only, never NEXT_PUBLIC_).
ENCRYPTION_KEY=
CRON_SECRET=

# Bluesky OAuth: apply the pending OAuth-state migration before enabling.
# Generate an EC P-256 private JWK with an ES256 algorithm and a unique kid.
# Only the public key is served at /.well-known/jwks.json.
BLUESKY_OAUTH_CLIENT_ID=https://agency-review-portal.vercel.app/oauth-client-metadata.json
BLUESKY_OAUTH_REDIRECT_URI=https://agency-review-portal.vercel.app/api/auth/bluesky/callback
BLUESKY_OAUTH_PRIVATE_JWK=

# Threads uses its own Threads app credentials, separate from Facebook Login.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://agency-review-portal.vercel.app/api/auth/threads/callback

# X requires a developer app with OAuth 2.0 user permissions and API credits.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://agency-review-portal.vercel.app/api/auth/x/callback

# Google project: enable YouTube Data API v3 and configure its OAuth consent.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://agency-review-portal.vercel.app/api/auth/youtube/callback

# Pinterest needs the platform-constraint migration. Trial Pins are creator-only.
# Standard access is required for public Pins.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=https://agency-review-portal.vercel.app/api/auth/pinterest/callback
