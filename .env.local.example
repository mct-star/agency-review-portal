# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (email notifications)
RESEND_API_KEY=re_your-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Meta Facebook Login. Add the callback and data-deletion URL in the Meta app settings.
# Callback: https://agency-review-portal.vercel.app/api/auth/meta/callback
# Privacy: https://agency-review-portal.vercel.app/privacy#social-data-deletion
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://agency-review-portal.vercel.app/api/auth/meta/callback
META_GRAPH_API_VERSION=
META_LOGIN_CONFIG_ID=
# Configure Meta Login for Business to issue a user access token, not a system user token.
